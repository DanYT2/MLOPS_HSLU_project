# Container image for the local MLflow tracking and artifact server.
#
# The API service points MLFLOW_TRACKING_URI at this container, and docker-compose
# mounts both the SQLite backend store and artifact directory for persistence.
FROM python:3.13-slim

# uv is copied from its official image to install MLflow quickly without adding
# an extra bootstrap step to the Dockerfile.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Install MLflow into the system Python for a compact single-purpose image. The
# no-cache flag avoids retaining wheel/download artifacts after installation.
RUN uv pip install mlflow --system --no-cache

# MLflow reads and writes its backend database and artifacts under this
# directory. docker-compose mounts a named volume at /mlflow/db for the SQLite
# backend store and a directory at /mlflow/mlruns for artifacts.
WORKDIR /mlflow

# MLflow serves its tracking UI and REST API on this port inside the Compose
# network and on localhost:5001 through the compose port mapping.
EXPOSE 5001

# Start MLflow as both the tracking server and artifact server. SQLite is enough
# for this local coursework/demo stack. Artifacts are served through the tracking
# server's proxy: experiments record artifacts under the ``mlflow-artifacts:/``
# scheme (--default-artifact-root), and the server physically stores them at
# --artifacts-destination (/mlflow/mlruns, a mounted directory). This matters
# because train.py runs on the host: with a *local* artifact root the client
# would try to write directly to the container path ``/mlflow/...`` on the host
# filesystem (read-only system root on macOS → "Read-only file system"). Proxying
# makes the host client upload over HTTP instead, and the API container resolves
# ``models:/...@champion`` through the same proxy. The allowed-hosts list
# restricts accepted Host headers to the Compose service name and local
# development addresses used by browsers, curl, and the API container.
CMD [ \
    "mlflow", "server", \
    "--host", "0.0.0.0", \
    "--port", "5001", \
    "--backend-store-uri", "sqlite:////mlflow/db/mlflow.db", \
    "--serve-artifacts", \
    "--artifacts-destination", "/mlflow/mlruns", \
    "--default-artifact-root", "mlflow-artifacts:/", \
    "--allowed-hosts", "mlflow,mlflow:5001,localhost,localhost:5001,127.0.0.1,127.0.0.1:5001" \
]
